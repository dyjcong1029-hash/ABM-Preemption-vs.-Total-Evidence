      <setup>set-plot-x-range 0 total-ticks-fixed</setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Expert" color="-8630108" legend="true"><setup></setup><update>plotxy ticks expert-posterior-truth-mass</update></pen>
