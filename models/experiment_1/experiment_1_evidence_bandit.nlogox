  <previewCommands>setup repeat 20 [ go ]</previewCommands>

  <experiments>
    <experiment name="experiment-1-evidence-smoke" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="600">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= total-ticks-fixed</exitCondition>
      <metrics>
        <metric>actual-seed</metric>
        <metric>hidden-world</metric>
        <metric>ticks</metric>
        <metric>expert-total-pulls</metric>
        <metric>total-lay-pulls</metric>
        <metric>expert-truth-mass-at-25</metric>
        <metric>expert-recommendation-score-at-25</metric>
        <metric>expert-informative-observations-at-25</metric>
        <metric>mean-lay-truth-mass-at-25</metric>
        <metric>mean-lay-recommendation-score-at-25</metric>
        <metric>mean-lay-informative-observations-at-25</metric>
        <metric>mean-lay-archive-size-at-25</metric>
        <metric>mean-lay-cumulative-regret-at-25</metric>
