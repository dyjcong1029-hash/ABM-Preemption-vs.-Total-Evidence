<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[;; ============================================================
;; Version 1.1: Total Evidence vs Preemption
;; Royal Family Network
;;
;; Network:
;;   turtle 0 = expert, located at the center
;;   all other turtles = laypersons, located on the outer cycle
;;
;; Arms / Strategies:
;;   Arm 0 = Total Evidence
;;   Arm 1 = Preemption
;;
;; Total Evidence:
;;   S*(p) = w * A(p) + (1 - w) * S(p)
;;
;;   where:
;;     S(p) = layperson's private credence
;;     A(p) = authority's credence
;;     w = trust-factor
;;
;; Preemption:
;;   S*(p) = A(p)
;;
;; Important:
;;   Agents do NOT learn the expert's alpha/beta.
;;   They receive the expert's credence A(p).
;;
;; Target proposition p is assumed to be true.
;; A strategy succeeds if the resulting credence in p is > 0.5.
;; ============================================================


globals [
  strategy-names
  final-performance
  final-performance-var
]


turtles-own [
  expert?

  ;; observed performance of each strategy
  bandit-obs-mean
  bandit-obs-n

  ;; personal performance tracking
  bandit-perf
  bandit-perf-n

  ;; current strategy choice
  current-best
  current-bandit
  current-result

  ;; credences used in current round
  current-private-credence
  current-expert-credence
  current-updated-credence

  ;; expert credence in the current round
  expert-current-credence

  ;; reevaluation counter
  time-since-reeval
]


;; ============================================================
;; setup
;; ============================================================

to setup
  clear-all

  set strategy-names (list "Total Evidence" "Preemption")

  crt Number-Of-Agents [
    set expert? false

    set current-private-credence 0
    set current-expert-credence 0
    set current-updated-credence 0
    set expert-current-credence 0

    ;; Initial sampling from both strategies.
    set bandit-obs-mean n-values Number-Of-Bandits [
      i -> mean n-values Initial-Sample [draw-policy-result-initial i]
    ]

    set bandit-obs-n n-values Number-Of-Bandits [
      Initial-Sample
    ]

    set bandit-perf n-values Number-Of-Bandits [0]
    set bandit-perf-n n-values Number-Of-Bandits [0]

    set current-best position (max bandit-obs-mean) bandit-obs-mean
    set current-bandit -1
    set current-result 0
    set time-since-reeval 0

    set shape "circle"
    set color gray

    if Visuals? [
      move-to one-of patches
    ]
  ]

  ;; Set turtle 0 as the expert.
  ask turtle 0 [
    set expert? true
    set shape "star"
    set color red
  ]

  setup-royal-family-network

  if Visuals? [
    layout-radial turtles links turtle 0
  ]

  reset-ticks
end


;; ============================================================
;; setup royal family / wheel network
;; ============================================================

to setup-royal-family-network
  if Number-Of-Agents < 3 [
    user-message "Number-Of-Agents must be at least 3 for a royal family / wheel network."
    stop
  ]

  let laypersons turtles with [not expert?]

  ;; Expert is connected to every layperson.
  ask turtle 0 [
    create-links-with laypersons
  ]

  ;; Laypersons form an outer cycle.
  ask laypersons [
    let num who
    let next-num ifelse-value (num = Number-Of-Agents - 1)
      [1]
      [num + 1]

    create-link-with turtle next-num
  ]
end


;; ============================================================
;; go
;; ============================================================

to go
  step
end


;; ============================================================
;; go-full
;; Runs multiple trials.
;; ============================================================

to go-full
  let results []

  repeat Number-Of-Trials [
    setup

    repeat Number-Of-Pulls [
      step
    ]

    set results lput (mean [my-performance] of turtles with [not expert?]) results
  ]

  set final-performance mean results
  set final-performance-var variance results
end


;; ============================================================
;; step
;; ============================================================

to step
  if ticks > Number-Of-Pulls [
    set final-performance mean [my-performance] of turtles with [not expert?]
    stop
  ]

  ;; Expert generates one credence A(p) this round.
  ask turtle 0 [
    set expert-current-credence generate-credence expert-reliability
  ]

  ;; Laypersons choose either Total Evidence or Preemption.
  ask turtles with [not expert?] [
    play
  ]

  ;; Laypersons learn from nearby laypersons' observed strategy performance.
  ask turtles with [not expert?] [
    update-network-royal
  ]

  tick
end


;; ============================================================
;; play
;; Called by laypersons.
;; ============================================================

to play
  set time-since-reeval time-since-reeval + 1

  ifelse random-float 1 < epsilon [
    ;; Exploration
    set current-bandit random Number-Of-Bandits
    set shape "triangle"
  ]
  [
    ;; Exploitation
    if time-since-reeval = Reeval-Frequency [
      set current-best position (max bandit-obs-mean) bandit-obs-mean
      set time-since-reeval 0
    ]

    set current-bandit current-best
    set shape "circle"
  ]

  set current-result draw-policy-result current-bandit

  ;; Track personal performance of chosen strategy.
  let old-mean item current-bandit bandit-perf
  let old-n item current-bandit bandit-perf-n
  let new-mean ((old-n * old-mean) + current-result) / (old-n + 1)

  set bandit-perf replace-item current-bandit bandit-perf new-mean
  set bandit-perf-n replace-item current-bandit bandit-perf-n (old-n + 1)

  ;; Visualization:
  ;; yellow-ish = Total Evidence
  ;; blue-ish = Preemption
  if current-bandit = 0 [
    set color 45
  ]

  if current-bandit = 1 [
    set color 105
  ]
end


;; ============================================================
;; generate-credence
;;
;; Generates a credence in p.
;;
;; The target proposition p is assumed to be true.
;;
;; With probability reliability, the credence is on the correct side:
;;   credence in [0.5, 1]
;;
;; With probability 1 - reliability, the credence is on the wrong side:
;;   credence in [0, 0.5)
;;
;; This lets reliability control how often the source is directionally correct.
;; ============================================================

to-report generate-credence [reliability]
  ifelse random-float 1 < reliability [
    report 0.5 + random-float 0.5
  ]
  [
    report random-float 0.5
  ]
end


;; ============================================================
;; draw-policy-result
;;
;; Reports whether a chosen strategy produces a correct belief.
;;
;; Arm 0 = Total Evidence:
;;   S*(p) = trust-factor * A(p) + (1 - trust-factor) * S(p)
;;
;; Arm 1 = Preemption:
;;   S*(p) = A(p)
;;
;; A strategy succeeds if S*(p) > 0.5.
;; ============================================================

to-report draw-policy-result [strategy]
  if strategy > 1 [
    user-message "This model has only two strategies: 0 = Total Evidence, 1 = Preemption."
  ]

  let private-credence generate-credence lay-reliability
  let authority-credence [expert-current-credence] of turtle 0
  let updated-credence 0

  ;; Strategy 0: Total Evidence.
  if strategy = 0 [
    set updated-credence
      (trust-factor * authority-credence) +
      ((1 - trust-factor) * private-credence)
  ]

  ;; Strategy 1: Preemption.
  if strategy = 1 [
    set updated-credence authority-credence
  ]

  set current-private-credence private-credence
  set current-expert-credence authority-credence
  set current-updated-credence updated-credence

  if updated-credence > 0.5 [
    report 1
  ]

  report 0
end


;; ============================================================
;; draw-policy-result-initial
;;
;; Used only during setup for Initial-Sample.
;; Since expert-current-credence has not yet been generated for a real round,
;; we simulate authority credence directly here.
;; ============================================================

to-report draw-policy-result-initial [strategy]
  if strategy > 1 [
    user-message "This model has only two strategies: 0 = Total Evidence, 1 = Preemption."
  ]

  let private-credence generate-credence lay-reliability
  let authority-credence generate-credence expert-reliability
  let updated-credence 0

  ;; Strategy 0: Total Evidence.
  if strategy = 0 [
    set updated-credence
      (trust-factor * authority-credence) +
      ((1 - trust-factor) * private-credence)
  ]

  ;; Strategy 1: Preemption.
  if strategy = 1 [
    set updated-credence authority-credence
  ]

  if updated-credence > 0.5 [
    report 1
  ]

  report 0
end


;; ============================================================
;; update-network-royal
;;
;; Laypersons update their observed performance estimates
;; from nearby laypersons.
;;
;; Important:
;;   Expert is NOT included as a strategy learner.
;;   The expert only supplies credence A(p).
;; ============================================================

to update-network-royal
  let updaters (turtle-set self (link-neighbors with [not expert?]))

  foreach n-values Number-Of-Bandits [i -> i] [
    i ->
    let results [current-result] of (updaters with [current-bandit = i])

    if not empty? results [
      let mperf mean results
      let num length results

      let old-mean item i bandit-obs-mean
      let old-n item i bandit-obs-n
      let new-mean ((old-n * old-mean) + (num * mperf)) / (old-n + num)

      set bandit-obs-mean replace-item i bandit-obs-mean new-mean
      set bandit-obs-n replace-item i bandit-obs-n (old-n + num)
    ]
  ]
end


;; ============================================================
;; my-performance
;; Called in turtle context.
;; Reports the average payoff of the strategies the agent has used.
;; ============================================================

to-report my-performance
  if ticks = 0 [
    report 0
  ]

  if sum bandit-perf-n = 0 [
    report 0
  ]

  report (sum (map * bandit-perf bandit-perf-n)) / (sum bandit-perf-n)
end


;; ============================================================
;; Reporters for plots and BehaviorSpace
;; ============================================================

to-report proportion-total-evidence
  let laypersons turtles with [not expert?]

  if count laypersons = 0 [
    report 0
  ]

  report count laypersons with [current-bandit = 0] / count laypersons
end


to-report proportion-preemption
  let laypersons turtles with [not expert?]

  if count laypersons = 0 [
    report 0
  ]

  report count laypersons with [current-bandit = 1] / count laypersons
end


to-report proportion-best-total-evidence
  let laypersons turtles with [not expert?]

  if count laypersons = 0 [
    report 0
  ]

  report count laypersons with [current-best = 0] / count laypersons
end


to-report proportion-best-preemption
  let laypersons turtles with [not expert?]

  if count laypersons = 0 [
    report 0
  ]

  report count laypersons with [current-best = 1] / count laypersons
end


to-report mean-total-evidence-estimate
  report mean [item 0 bandit-obs-mean] of turtles with [not expert?]
end


to-report mean-preemption-estimate
  report mean [item 1 bandit-obs-mean] of turtles with [not expert?]
end


to-report strategy-gap
  report mean-preemption-estimate - mean-total-evidence-estimate
end


to-report preemption-majority?
  report proportion-best-preemption > 0.5
end


to-report mean-updated-credence
  report mean [current-updated-credence] of turtles with [not expert?]
end


to-report mean-private-credence
  report mean [current-private-credence] of turtles with [not expert?]
end


to-report mean-expert-credence
  report mean [current-expert-credence] of turtles with [not expert?]
end]]></code>
