  <experiments>
    <experiment name="version1_reliability_sweep" repetitions="500" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>step</go>
      <metrics>
        <metric>proportion-best-preemption</metric>
        <metric>proportion-best-total-evidence</metric>
        <metric>proportion-preemption</metric>
        <metric>proportion-total-evidence</metric>
        <metric>mean-preemption-estimate</metric>
        <metric>mean-total-evidence-estimate</metric>
        <metric>mean [my-performance] of turtles with [not expert?]</metric>
        <metric>strategy-gap</metric>
        <metric>preemption-majority?</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="expert-reliability">
          <value value="0.55"></value>
          <value value="0.6"></value>
          <value value="0.65"></value>
          <value value="0.7"></value>
          <value value="0.75"></value>
          <value value="0.8"></value>
          <value value="0.85"></value>
          <value value="0.9"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="lay-reliability">
          <value value="0.5"></value>
          <value value="0.55"></value>
          <value value="0.6"></value>
          <value value="0.65"></value>
          <value value="0.7"></value>
          <value value="0.75"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="Number-Of-Agents">
          <value value="30"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="Number-Of-Bandits">
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="Number-Of-Pulls">
          <value value="1000"></value>
        </enumeratedValueSet>
